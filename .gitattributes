# 统一换行为 LF，跨平台一致（消除 Windows CRLF diff 噪音）
* text=auto eol=lf

# Cocos 的 .meta 是文本，需提交且统一 LF
*.meta text eol=lf

# typedoc 生成物：入库供 GitLab 直接阅读，但 MR diff 里折叠，别淹没人工改动
packages/core/docs/api/** gitlab-generated=true linguist-generated=true

# 二进制资源：不做换行/diff 转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.bmp  binary
*.ttf  binary
*.otf  binary
*.mp3  binary
*.ogg  binary
*.wav  binary
*.mp4  binary
