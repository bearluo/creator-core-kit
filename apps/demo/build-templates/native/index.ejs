// 定制版原生启动模板 —— 覆盖 Creator 内置 templates/native/index.ejs 渲染出的 data/main.js。
//
// 为什么要覆盖：热更 apply() 把新资源目录写进 localStorage['HotUpdateSearchPaths'] 后，**冷启动**
// （进程被杀重开）必须在读取任何 src/ 文件之前把搜索路径还原，否则引擎照旧从包内加载旧代码 ——
// 而且它不报错，是安静地跑旧版本。（game.restart() 同进程热重启不受影响：apply() 已在内存里
// setSearchPaths 过了。）见 packages/core/docs/modules/hotupdate-service.md、ADR-0006。
//
// 为什么放这里而不是改构建产物：data/main.js 每次构建都由本模板重新渲染，改产物必被覆盖。
// build-templates/native/ 是 Creator 3.8 官方支持的原生模板覆盖点，android/ios/windows 共用这一份。
// 升级 Creator 后与内置模板 diff 一次（内置模板在
// <Creator>/resources/resources/3d/engine/templates/native/index.ejs）。

// ==== 热更搜索路径还原（必须先于任何 require）====
// 此刻可用：jsb.fileUtils / localStorage / XMLHttpRequest（jsb-adapter/web-adapter.js 已在
// C++ BaseGame::init 里先于 main.js 跑完）；不可用：cc、SystemJS。
// 主体照抄官方 hot-update 教程那段（还原搜索路径 + 修复"下载完成、移动到一半被杀"的 `_temp/` 残留），
// 只多包一层 try/catch：存档坏了退回包内版本启动，别把玩家卡在黑屏。
// 注：官方 `srcPath[srcPath.length]` 恒为 undefined（下标越界一位），那个建目录分支实际走不到 ——
// 保持与官方一致，没自作主张改。
(function () {
    try {
        if (typeof window.jsb === 'object') {
            var hotUpdateSearchPaths = localStorage.getItem('HotUpdateSearchPaths'); // 须与 backend 的 searchPathsKey 一致
            if (hotUpdateSearchPaths) {
                var paths = JSON.parse(hotUpdateSearchPaths);
                jsb.fileUtils.setSearchPaths(paths);

                var fileList = [];
                var storagePath = paths[0] || '';
                var tempPath = storagePath + '_temp/';
                var baseOffset = tempPath.length;

                if (jsb.fileUtils.isDirectoryExist(tempPath) && !jsb.fileUtils.isFileExist(tempPath + 'project.manifest.temp')) {
                    jsb.fileUtils.listFilesRecursively(tempPath, fileList);
                    fileList.forEach(srcPath => {
                        var relativePath = srcPath.substr(baseOffset);
                        var dstPath = storagePath + relativePath;

                        if (srcPath[srcPath.length] == '/') {
                            jsb.fileUtils.createDirectory(dstPath)
                        }
                        else {
                            if (jsb.fileUtils.isFileExist(dstPath)) {
                                jsb.fileUtils.removeFile(dstPath)
                            }
                            jsb.fileUtils.renameFile(srcPath, dstPath);
                        }
                    })
                    jsb.fileUtils.removeDirectory(tempPath);
                }
            }
        }
    } catch (e) {
        console.error('[cck] 还原热更搜索路径失败，回退内置版本: ' + e);
    }
})();

<% if(polyfillsBundleFile) { %>
// Polyfills bundle.
require("<%= polyfillsBundleFile %>");
<% } %>

// SystemJS support.
window.self = window;
require("<%= systemJsBundleFile %>");

const importMapJson = jsb.fileUtils.getStringFromFile("<%= importMapFile%>");
const importMap = JSON.parse(importMapJson);
System.warmup({
    importMap,
    importMapUrl: '<%= importMapFile%>',
    defaultHandler: (urlNoSchema) => {
        require(urlNoSchema.startsWith('/') ? urlNoSchema.substr(1) : urlNoSchema);
    },
});

// ==== AOT 入口：固定名指针 → 运行时解析（这就是 AOT 可热更的全部机关）====
//
// Creator 内置模板把 `application.<md5>.js` 的名字**烘死**在这里，于是热更下发的新 AOT
// （application → settings → chunks → assets/{main,resources,internal}）永远没人念 —— 整个
// AOT 层因此结构性不可热更。而这段代码跑在**搜索路径还原之后**，完全可以改成运行时解析：
// 读固定名 `src/cck-aot.json` 拿入口名，热更目录里有新的就命中新的，没有就落到包内那份。
// 见 docs/design/2026-08-20-aot-hotupdate-unlock-proposal.md。
//
// 兜底一律「退回包内版本」而不是抛：黑屏是最坏结果，退回还能起来，下一轮 check 会重下。
var applicationJs = '<%= applicationJs %>';
// 包内那份的名字 = **这个 APK 的身份**（热更改不了 main.js）。engine 的 `packagedAotEntry()`
// 读它判「APK 换没换」；不能用运行时 settings.bundleVers，那个现在会随热更翻、会自噬缓存。
window.__cckAotEntry = applicationJs;
(function () {
    try {
        var raw = jsb.fileUtils.getStringFromFile('src/cck-aot.json');
        if (!raw) return;
        var name = JSON.parse(raw).application;
        if (typeof name !== 'string' || name === '' || name === applicationJs) return;
        // 指针在、文件不在 = 半更新（下载完成、搬运被杀）。上面那段 `_temp/` 修复通常已经补齐，
        // 补不齐就退回包内，别把玩家卡在黑屏。
        if (!jsb.fileUtils.isFileExist(name.indexOf('./') === 0 ? name.substr(2) : name)) {
            console.error('[cck] AOT 指针指向的文件不存在，回退包内版本: ' + name);
            return;
        }
        applicationJs = name;
        console.log('[cck] AOT 入口取热更版本: ' + name);
    } catch (e) {
        console.error('[cck] 读 AOT 入口指针失败，回退包内版本: ' + e);
    }
})();

System.import(applicationJs)
.then(({ Application }) => {
    return new Application();
}).then((application) => {
    return System.import('cc').then((cc) => {
        require('jsb-adapter/engine-adapter.js');
        return application.init(cc);
    }).then(() => {
        return application.start();
    });
}).catch((err) => {
    console.error(err.toString() + ', stack: ' + err.stack);
});
