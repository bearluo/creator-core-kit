{
  "platform": "android",
  "outputName": "android",
  "taskName": "android-boot",
  "startScene": "db://assets/boot/Boot.scene",
  "debug": true,
  "md5Cache": true,
  "sourceMaps": true,
  "buildMode": "normal",
  "mainBundleCompressionType": "merge_dep",
  "engineModulesConfigKey": "defaultConfig",
