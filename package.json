{
  "name": "creator-core-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "pnpm lint:pkgs && pnpm lint:demo",
    "lint:pkgs": "eslint .",
    "lint:demo": "eslint --no-config-lookup --config apps/demo/eslint.config.mjs apps/demo",
    "check:vm-tests": "node scripts/check-vm-tests.mjs",
    "check:pins": "node packages/tools/dist/cli.cjs check-pins --assets apps/demo/assets",
    "check:graph": "node packages/tools/dist/cli.cjs check-graph --assets apps/demo/assets",
    "gen:masks": "node apps/demo/scripts/gen-collision-mask.mjs",
    "check:masks": "node apps/demo/scripts/gen-collision-mask.mjs --check",
    "proto:sync": "node scripts/sync-proto.mjs",
    "docs:api": "typedoc",
    "typecheck": "pnpm typecheck:pkgs && pnpm typecheck:demo",
    "typecheck:pkgs": "tsc -b",
    "typecheck:demo": "tsc -p apps/demo/tsconfig.check.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typedoc": "^0.27.9",
    "typedoc-plugin-markdown": "^4.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
