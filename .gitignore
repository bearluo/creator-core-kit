# 不上传的实验 / 摸底项目（专用于验证 Cocos 特性，结论回填 docs/research）
/spike/

# Node / pnpm monorepo
node_modules/
dist/
dist-types/
coverage/
*.tsbuildinfo
*.log
.pnpm-store/

# Cocos Creator 工程生成物（apps/demo 等）
**/library/
**/temp/
**/local/
**/build/
**/profiles/
**/native/

# funplay-cocos MCP 编辑器扩展（第三方 dev 工具，装在 demo 工程内实测，不入库；
# 源码在 spike/bundle-probe/extensions 或 npm i -g funplay-cocos-mcp）
/apps/demo/extensions/funplay-cocos-mcp/
# funplay MCP 扩展运行时生成的本地配置（含端口/工具开关，因人而异，不入库）
/apps/demo/funplay-cocos-mcp.config.json

# Creator 自动生成的脚本模板帮助链接（.url，随编辑器版本再生，不入库；
# 同目录的 default-meta.json 是项目配置，照常提交）
/apps/demo/.creator/asset-template/

# 系统 / 编辑器
.DS_Store
Thumbs.db
