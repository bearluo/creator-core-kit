{
  // 仅供 tsup 消费构建（JS + d.ts）。关掉 composite/incremental：tsup 的 dts 步骤与
  // project-references 的 composite 不兼容（TS6307）。清空 references（dts 走 node_modules
  // 解析 @cck/core，不用 build 编排）。typecheck 走 tsconfig.json（composite:true）。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declarationMap": false,
    // 覆盖父配置的 paths：**构建时** @cck/core 走 node_modules（core 的 tsup dist，external），
    // 不引 core 源码（否则源码在 engine rootDir 外触发 TS6059）。cc 类型由父配置继承的
    // @cocos/creator-types 提供（ambient declare module 'cc'），无需 paths 映射。
    "paths": {}
  },
  "references": []
}
