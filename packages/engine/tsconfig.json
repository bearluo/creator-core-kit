{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    // tsc 的 .d.ts 出到 dist-types，dist 归 tsup 独占（同 core，见 ADR-0003/0004 的 dist footgun）。
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": [],
    "paths": {
      "cc": ["./test/mocks/cc.ts"],
      // typecheck 时 @cck/core 解析到 core **源码**（永远最新、完整），与 tsup 产的 dist 解耦，
      // 使 `pnpm typecheck` 不依赖「先 build core」。运行期/Cocos 仍走 node_modules 的 dist（external）。
      "@cck/core": ["../core/src/index.ts"]
    }
  },
  "references": [{ "path": "../core" }],
  "include": ["src/**/*", "test/mocks/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/__tests__/**"]
}
