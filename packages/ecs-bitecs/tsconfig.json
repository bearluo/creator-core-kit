{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // 与 core 同构：tsc 只出 .d.ts 到 dist-types 供 typecheck/composite；
    // dist（供 Cocos/其它包消费的单包）由 tsup 独占产出。二者分开，避免 clean 互抹。
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/__tests__/**"]
}
