{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // tsc 的 .d.ts 出到 dist-types，与 tsup 独占的 dist **完全分开**：dist 由 tsup 产自包含
    // 单包（index.js + 打平的 index.d.ts），供 Creator/其它包按 package.json 消费；tsc 只为
    // typecheck/composite 出多文件 .d.ts 到 dist-types。二者不再共用 dist —— 否则 tsup 的
    // clean 抹掉 tsc 的子 .d.ts、而 tsc 增量又拒绝重生成，barrel 再导出全落空（footgun 变种）。
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/__tests__/**"]
}
